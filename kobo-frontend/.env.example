# Copy to kobo-frontend/.env and fill in.

# The Nest API as this process reaches it — internal, not the public hostname.
# Requests go server to server with the reader's session cookie forwarded, so
# nothing here is subject to CORS or WEB_ORIGIN (§D20).
API_URL="http://localhost:3000"

PORT=4000

# Required, no default, same argument as the backend's copy.
NODE_ENV=development

# Number of reverse proxies in front. In production this is what makes
# X-Forwarded-Proto trustworthy, which is how /probe reports whether the
# request arrived over TLS. Leave at 0 when running this directly.
TRUST_PROXY=0
