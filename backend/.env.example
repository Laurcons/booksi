# Copy to backend/.env and fill in. Never committed — see .gitignore.

DATABASE_URL="mysql://bookcsi:bookcsi_dev@localhost:3306/bookcsi"

# Google Cloud console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (type: Web application). The callback below must be listed verbatim under
# "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Signs the session JWT. Any long random string: openssl rand -base64 48
JWT_SECRET=

# Single allowed browser origin — CORS runs with credentials, so "*" is not an
# option (§D20).
WEB_ORIGIN="http://localhost:5173"

# The API's own public URL. Feeds the MCP OAuth metadata documents and the
# `aud` check on /mcp (docs/MCP.md §6).
API_ORIGIN="http://localhost:3000"

PORT=3000

# Required, with no default on purpose. `Secure` on the session cookie and
# whether the docs are served both hang off it, so an unset value would quietly
# pick the less safe option on a real deployment. The API prints what it
# resolved to on the first line of its logs.
NODE_ENV=development

# Number of reverse proxies in front of the API, for the per-IP rate limiter.
# Leave at 0 unless there really is one: trusting X-Forwarded-For with no proxy
# lets a client name its own IP and step around the limiter.
TRUST_PROXY=0

# Swagger UI on /docs (JSON on /docs-json). Unset means on outside production,
# which is what you want locally — set it only to force the other behaviour.
# ENABLE_DOCS=true

# The single preregistered MCP client (docs/MCP.md §1). Mint MCP_CLIENT_SECRET
# yourself: openssl rand -base64 32
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
# Comma-separated, matched exactly against what the assistant sends.
MCP_REDIRECT_URIS=
# What the consent screen calls this client. Optional.
# MCP_CLIENT_DISPLAY_NAME="Claude"
