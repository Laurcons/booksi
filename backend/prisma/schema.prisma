// Schema as specified in docs/ARCHITECTURE.md. Sprint 0 only reads and writes
// `User`, but the rest is created up front so the first migration matches the
// documented model instead of growing by accretion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?  @db.Text
  createdAt DateTime @default(now())

  /// Bumped on logout, which is what makes logout mean anything: the session
  /// is a signed JWT, so clearing the cookie only removes the browser's copy
  /// and any token captured beforehand keeps working for its full 30 days.
  /// Every token carries the version it was signed under and is refused once
  /// this moves past it. One counter per user, so a logout ends every session
  /// on every device — see S0.2.
  tokenVersion Int @default(0)

  books     Book[]
  settings  Settings?
  mcpGrants McpGrant[]
}

enum Status {
  WISHLIST
  PURCHASED
  READING
  FINISHED
  ABANDONED
}

enum Genre {
  FICTION
  SCIFI
  FANTASY
  THRILLER
  ROMANCE
  HISTORICAL
  MEMOIR
  NONFICTION
  SELF_HELP
  BUSINESS
  SCIENCE
  PHILOSOPHY
  PSYCHOLOGY
  POETRY
  COMICS_MANGA
  CHILDREN_YA
  OTHER
}

model Book {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // identity (user-input or Open Library)
  title        String
  author       String?
  isbn         String? // NOT unique — see D13
  totalPages   Int? // frequently absent — see D4
  genre        Genre?
  olEditionKey String?

  // state (user-input)
  status    Status  @default(WISHLIST)
  favorite  Boolean @default(false)
  pagesRead Int     @default(0)
  rating    Int? // 1-5

  // money
  estimatedPrice Decimal? @db.Decimal(10, 2)
  paidPrice      Decimal? @db.Decimal(10, 2)

  // dates (system-generated, user-overridable — see D1)
  purchasedOn DateTime? @db.Date
  startedOn   DateTime? @db.Date
  finishedOn  DateTime? @db.Date

  // system
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cover Cover?

  @@index([userId, status])
  @@index([userId, finishedOn])
  @@index([userId, purchasedOn])
}

enum CoverSource {
  OPEN_LIBRARY
  UPLOAD
}

model Cover {
  bookId String @id
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  data     Bytes       @db.LongBlob
  mimeType String
  source   CoverSource

  createdAt DateTime @default(now())

  /// The version in the cover's URL, and the reason it exists: the image is
  /// served with `Cache-Control: immutable` on the premise that a cover never
  /// changes, which S4.3's upload breaks — replace a cover and the browser
  /// would keep the old one for a year. `?v=<updatedAt>` moves with the image,
  /// so the new URL is simply a URL the cache has never seen.
  updatedAt DateTime @updatedAt
}

model Settings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyBudget Decimal? @db.Decimal(10, 2)
  yearlyBudget  Decimal? @db.Decimal(10, 2)
  currency      String   @default("RON")
}

// docs/MCP.md §5 — a preregistered client, so there is no `McpClient` model:
// `clientId` is configuration (MCP_CLIENT_ID), not a foreign key.

/// The unit of revocation: one user's consent for one client. Survives
/// logout (§D23 does not extend to MCP, docs/MCP.md §2) — revoked only from
/// its own screen.
model McpGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  scope    String
  label    String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  authCodes McpAuthCode[]
  tokens    McpToken[]

  @@index([userId])
}

/// The authorization code. Short-lived and single-use — `expiresAt` is 60
/// seconds out from creation, `usedAt` is set (and never unset) the moment
/// it is redeemed at `/oauth/token`.
model McpAuthCode {
  id      String   @id @default(cuid())
  grantId String
  grant   McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  codeHash      String @unique
  codeChallenge String
  redirectUri   String
  resource      String

  expiresAt DateTime
  usedAt    DateTime?

  @@index([grantId])
}

enum McpTokenType {
  ACCESS
  REFRESH
}

/// Access and refresh tokens in one table, discriminated by `type`. Opaque
/// and hashed (docs/MCP.md §5) — a JWT would validate without a query but
/// could not be revoked before it expired, which is the one property this
/// table exists for. `replacedById` is the rotation chain: a refresh token
/// presented a second time means `replacedById` is already set, which is the
/// reuse signal that revokes the whole grant.
model McpToken {
  id      String   @id @default(cuid())
  grantId String
  grant   McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  type      McpTokenType
  tokenHash String       @unique
  expiresAt DateTime

  replacedById String?   @unique
  replacedBy   McpToken? @relation("McpTokenRotation", fields: [replacedById], references: [id])
  replaces     McpToken? @relation("McpTokenRotation")

  createdAt DateTime @default(now())

  @@index([grantId])
}
