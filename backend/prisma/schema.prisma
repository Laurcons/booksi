// Schema as specified in docs/ARCHITECTURE.md. Sprint 0 only reads and writes
// `User`, but the rest is created up front so the first migration matches the
// documented model instead of growing by accretion.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String?
  avatarUrl String?  @db.Text
  createdAt DateTime @default(now())

  /// Bumped on logout, which is what makes logout mean anything: the session
  /// is a signed JWT, so clearing the cookie only removes the browser's copy
  /// and any token captured beforehand keeps working for its full 30 days.
  /// Every token carries the version it was signed under and is refused once
  /// this moves past it. One counter per user, so a logout ends every session
  /// on every device — see S0.2.
  tokenVersion Int @default(0)

  /// Set from `ADMIN_EMAILS` (config, not a UI) on every login — see §D38.
  /// Gates the impersonation routes on `AuthController` and nothing else.
  isAdmin Boolean @default(false)

  books          Book[]
  settings       Settings?
  mcpGrants      McpGrant[]
  devicePairings DevicePairing[]
  challenges     Challenge[]
}

enum Status {
  WISHLIST
  PURCHASED
  READING
  FINISHED
  ABANDONED
}

enum Genre {
  FICTION
  SCIFI
  FANTASY
  THRILLER
  ROMANCE
  HISTORICAL
  MEMOIR
  NONFICTION
  SELF_HELP
  BUSINESS
  SCIENCE
  PHILOSOPHY
  PSYCHOLOGY
  POETRY
  COMICS_MANGA
  CHILDREN_YA
  OTHER
}

model Book {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // identity (user-input or Open Library)
  title        String
  author       String?
  isbn         String? // NOT unique — see D13
  totalPages   Int? // frequently absent — see D4
  genre        Genre?
  olEditionKey String?

  // state (user-input)
  status    Status  @default(WISHLIST)
  favorite  Boolean @default(false)
  pagesRead Int     @default(0)
  rating    Int? // 1-5

  // money
  estimatedPrice Decimal? @db.Decimal(10, 2)
  paidPrice      Decimal? @db.Decimal(10, 2)

  // dates (system-generated, user-overridable — see D1)
  purchasedOn DateTime? @db.Date
  startedOn   DateTime? @db.Date
  finishedOn  DateTime? @db.Date

  // system
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cover Cover?
  challenges ChallengeBook[]

  @@index([userId, status])
  @@index([userId, finishedOn])
  @@index([userId, purchasedOn])
}

enum CoverSource {
  OPEN_LIBRARY
  UPLOAD
}

model Cover {
  bookId String @id
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  data     Bytes       @db.LongBlob
  mimeType String
  source   CoverSource

  createdAt DateTime @default(now())

  /// The version in the cover's URL, and the reason it exists: the image is
  /// served with `Cache-Control: immutable` on the premise that a cover never
  /// changes, which S4.3's upload breaks — replace a cover and the browser
  /// would keep the old one for a year. `?v=<updatedAt>` moves with the image,
  /// so the new URL is simply a URL the cache has never seen.
  updatedAt DateTime @updatedAt
}

/// A curated set of books against a deadline — see the design conversation
/// that led here (frontend/src/pages/ChallengePage.tsx started as a
/// local-state-only mock; this is what backs it for real).
///
/// `deadline` is a calendar day, not an instant, for the same reason the
/// three status dates on `Book` are (`@db.Date`, book.ts's own comment):
/// "the challenge ends August 31st" must not drift a day depending on which
/// side of UTC midnight the reader is on.
model Challenge {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  deadline    DateTime @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books ChallengeBook[]

  @@index([userId])
}

/// The join table. Many-to-many rather than a `challengeId` column on `Book`:
/// a book finished for one challenge can legitimately sit in a second (a
/// backlog challenge and a genre challenge both claiming the same read), and
/// a column on `Book` would cap it at one.
model ChallengeBook {
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)

  addedAt DateTime @default(now())

  @@id([challengeId, bookId])
  @@index([bookId])
}

model Settings {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  monthlyBudget Decimal? @db.Decimal(10, 2)
  yearlyBudget  Decimal? @db.Decimal(10, 2)
  currency      String   @default("RON")
}

enum PairingStatus {
  PENDING
  APPROVED
  CONSUMED
}

/// Pairing by code (§D37, docs/kobo_design.md §Autentificare). A Kobo cannot
/// complete the Google OAuth dance — the device's browser fails Google's own
/// safety check — so a session reaches it a different way: the Kobo mints a
/// code and holds it here as `PENDING`, a signed-in browser looks it up by
/// `code` and marks it `APPROVED`, and the Kobo exchanges the same row for a
/// session token and marks it `CONSUMED`. Each row is one attempt; a device
/// asking for a fresh code creates a new one rather than reusing an expired
/// row.
///
/// `expiresAt` is not policed by a job — `PairingService` treats a row past
/// its `expiresAt` as expired on read, the same way an unconfirmed one reads
/// as `PENDING` without a scheduled sweep. Ten minutes (`PAIRING_TTL_MINUTES`
/// in `shared/`) is short enough that a stale, unconsumed row is not a
/// meaningful way to reach someone else's account, and short-lived rows are
/// cheap to leave behind uncollected.
model DevicePairing {
  id   String @id @default(cuid())
  code String @unique

  status PairingStatus @default(PENDING)

  approvedByUserId String?
  approvedByUser   User?   @relation(fields: [approvedByUserId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  approvedAt DateTime?
  consumedAt DateTime?

  @@index([expiresAt])
}

// docs/MCP.md §5 — a preregistered client, so there is no `McpClient` model:
// `clientId` is configuration (MCP_CLIENT_ID), not a foreign key.

/// The unit of revocation: one user's consent for one client. Survives
/// logout (§D23 does not extend to MCP, docs/MCP.md §2) — revoked only from
/// its own screen.
model McpGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  scope    String
  label    String?

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  authCodes McpAuthCode[]
  tokens    McpToken[]

  @@index([userId])
}

/// The authorization code. Short-lived and single-use — `expiresAt` is 60
/// seconds out from creation, `usedAt` is set (and never unset) the moment
/// it is redeemed at `/oauth/token`.
model McpAuthCode {
  id      String   @id @default(cuid())
  grantId String
  grant   McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  codeHash      String @unique
  codeChallenge String
  redirectUri   String
  resource      String

  expiresAt DateTime
  usedAt    DateTime?

  @@index([grantId])
}

enum McpTokenType {
  ACCESS
  REFRESH
}

/// Access and refresh tokens in one table, discriminated by `type`. Opaque
/// and hashed (docs/MCP.md §5) — a JWT would validate without a query but
/// could not be revoked before it expired, which is the one property this
/// table exists for. `replacedById` is the rotation chain: a refresh token
/// presented a second time means `replacedById` is already set, which is the
/// reuse signal that revokes the whole grant.
model McpToken {
  id      String   @id @default(cuid())
  grantId String
  grant   McpGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  type      McpTokenType
  tokenHash String       @unique
  expiresAt DateTime

  replacedById String?   @unique
  replacedBy   McpToken? @relation("McpTokenRotation", fields: [replacedById], references: [id])
  replaces     McpToken? @relation("McpTokenRotation")

  createdAt DateTime @default(now())

  @@index([grantId])
}
